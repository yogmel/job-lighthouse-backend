POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=
# Frontend origins allowed by CORS, comma-separated, no trailing slash. Unset: none.
CORS_ALLOWED_ORIGINS=https://job-lighthouse.vercel.app,http://localhost:3000
# Required by both services. Use the same value in both. Generate: openssl rand -hex 32
JWT_SECRET=
# Optional. Without it, POST /auth/google returns 503.
GOOGLE_CLIENT_ID=
# Optional. Job Runner match scoring. Without it, new jobs are stored unscored.
OPENAI_API_KEY=
# Optional. Default: gpt-5-mini.
OPENAI_MODEL=
# Optional. POST /companies/detect calls per user per hour; over it is a 429. Default: 20.
DETECT_LIMIT_PER_HOUR=
# Optional. Transactional email (Resend). Without it, no email is sent.
RESEND_API_KEY=
# Required with RESEND_API_KEY. A sender on a domain verified in Resend.
EMAIL_FROM=
# Optional. Companies: frontend page that sets a new password. Reset emails link to it with ?token=... Unset: no reset email is sent.
PASSWORD_RESET_URL=
# Optional. Job Runner cron tick loop. Default: true. Set false to stop scheduled runs.
SCHEDULER_ENABLED=
